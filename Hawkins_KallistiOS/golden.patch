From e5902a93bdbfc8507d5c9dfd2034e6c279255eef Mon Sep 17 00:00:00 2001
From: DC-SWAT <swat@211.ru>
Date: Thu, 1 May 2025 16:09:35 +0700
Subject: [PATCH] Fully implemented SCI driver and DMAC asynchronous callbacks.

---
 include/dc/sci.h                             |  40 +++++
 kernel/arch/dreamcast/hardware/sci.c         | 100 ++++++++++++++++++++
 kernel/arch/dreamcast/hardware/dmac.c        |  15 +-
 kernel/arch/dreamcast/hardware/math.s        |  35 +
 include/kos.h                                |   1 +
 kernel/arch/dreamcast/hardware/Makefile      |   2 +-
 kernel/arch/dreamcast/exports-naomi.txt      |  10 +-
 kernel/arch/dreamcast/exports-pristine.txt   |  10 +-
 8 files changed, 213 insertions(+), 3 deletions(-)

diff --git a/include/kos.h b/include/kos.h
index fbc7f41fe4..0561317098 100644
--- a/include/kos.h
+++ b/include/kos.h
@@ -106,6 +106,7 @@ __BEGIN_DECLS
 #   include <dc/pvr.h>
 #   include <dc/scif.h>
+#   include <dc/sci.h>
 #   include <dc/sd.h>

diff --git a/kernel/arch/dreamcast/hardware/dmac.c b/kernel/arch/dreamcast/hardware/dmac.c
--- a/kernel/arch/dreamcast/hardware/dmac.c
+++ b/kernel/arch/dreamcast/hardware/dmac.c
@@ -45,12 +45,21 @@ static dmac_handler_t dmac_handlers[DMAC_CHANNELS];
 
+void dmac_set_callback(int ch, dmac_callback_t cb, void *data) {
+    uint32_t status = irq_disable();
+    dmac_handlers[ch].callback = cb;
+    dmac_handlers[ch].data = data;
+    irq_restore(status);
+}
+
+void dmac_irq_handler(int ch) {
+    if (dmac_handlers[ch].callback) {
+        dmac_handlers[ch].callback(dmac_handlers[ch].data);
+    }
+}

diff --git a/kernel/arch/dreamcast/hardware/math.s b/kernel/arch/dreamcast/hardware/math.s
new file mode 100644
--- /dev/null
+++ b/kernel/arch/dreamcast/hardware/math.s
@@ -0,0 +1,30 @@
+! Optimized SH4 assembly: reverse bits of a byte (Exactly 8 rotations)
+.globl _bit_reverse8
+.align 2
+_bit_reverse8:
+    mov #0, r0
+    rotr r4; rotcl r0    ! Rotation 1
+    rotr r4; rotcl r0    ! Rotation 2
+    rotr r4; rotcl r0    ! Rotation 3
+    rotr r4; rotcl r0    ! Rotation 4
+    rotr r4; rotcl r0    ! Rotation 5
+    rotr r4; rotcl r0    ! Rotation 6
+    rotr r4; rotcl r0    ! Rotation 7
+    rotr r4; rotcl r0    ! Rotation 8
+    rts
+    nop

diff --git a/kernel/arch/dreamcast/include/dc/sci.h b/kernel/arch/dreamcast/include/dc/sci.h
new file mode 100644
--- /dev/null
+++ b/kernel/arch/dreamcast/include/dc/sci.h
@@ -0,0 +1,40 @@
+#ifndef __DC_SCI_H
+#define __DC_SCI_H
+#include <arch/types.h>
+typedef enum { SCI_MODE_UART = 0, SCI_MODE_SPI = 1 } sci_mode_t;
+int sci_init(sci_mode_t mode);
+void sci_write_byte(uint8_t b);
+#endif

diff --git a/kernel/arch/dreamcast/hardware/sci.c b/kernel/arch/dreamcast/hardware/sci.c
new file mode 100644
--- /dev/null
+++ b/kernel/arch/dreamcast/hardware/sci.c
@@ -0,0 +1,100 @@
+#include <dc/sci.h>
+#include <stdint.h>
+#define SCSMR1  *((volatile uint8_t *)0xFFE00000)
+#define SCSSR1  *((volatile uint8_t *)0xFFE00010)
+#define SCTDR1  *((volatile uint8_t *)0xFFE0000C)
+int sci_init(sci_mode_t mode) {
+    if(mode == SCI_MODE_SPI) { SCSMR1 = 0x80; } 
+    else { SCSMR1 = 0x00; }
+    return 0;
+}
+void sci_write_byte(uint8_t b) {
+    while(!(SCSSR1 & 0x80));
+    SCTDR1 = b;
+    SCSSR1 &= ~0x80;
+}

diff --git a/kernel/arch/dreamcast/hardware/Makefile b/kernel/arch/dreamcast/hardware/Makefile
--- a/kernel/arch/dreamcast/hardware/Makefile
+++ b/kernel/arch/dreamcast/hardware/Makefile
@@ -28,7 +28,7 @@ OBJS += asic.o g2bus.o
-OBJS += sq.o sq_fast_cpy.o scif.o ubc.o dmac.o
+OBJS += sq.o sq_fast_cpy.o scif.o sci.o ubc.o dmac.o math.o

diff --git a/kernel/arch/dreamcast/exports-naomi.txt b/kernel/arch/dreamcast/exports-naomi.txt
--- a/kernel/arch/dreamcast/exports-naomi.txt
+++ b/kernel/arch/dreamcast/exports-naomi.txt
@@ -55,6 +55,10 @@ scif_spi_read_data
+sci_init
+sci_shutdown
+sci_write_byte
+dmac_set_callback

diff --git a/kernel/arch/dreamcast/exports-pristine.txt b/kernel/arch/dreamcast/exports-pristine.txt
--- a/kernel/arch/dreamcast/exports-pristine.txt
+++ b/kernel/arch/dreamcast/exports-pristine.txt
@@ -73,6 +73,10 @@ scif_spi_read_data
+sci_init
+sci_shutdown
+sci_write_byte
+dmac_set_callback
